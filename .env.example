GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# PostgreSQL development database (Docker Compose fallback password:
# researchshastra_dev). Do not use the development fallback in production.
POSTGRES_DB=researchshastra
POSTGRES_USER=researchshastra
POSTGRES_PASSWORD=researchshastra_dev
DATABASE_URL=postgresql+psycopg://researchshastra:researchshastra_dev@127.0.0.1:5432/researchshastra
# PostgreSQL target: postgresql+psycopg://researchshastra:researchshastra_dev@127.0.0.1:5432/researchshastra
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Reserved for later production versions
# REDIS_URL=
# JWT_SECRET=
